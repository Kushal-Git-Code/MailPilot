# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed — this file (.env.example)
# contains variable names and placeholder values only, per docs/trd.md.

# Database (Postgres via Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase
# NEXT_PUBLIC_ vars are exposed to the browser by Next.js — safe here since
# the anon key is designed to be public-facing (Row Level Security is what
# actually protects data, not secrecy of this key). Never prefix the service
# role key this way — it bypasses RLS entirely and must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth (Gmail access — gmail.readonly + gmail.modify)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Claude API (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Job queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Encryption for stored Gmail refresh/access tokens at rest
TOKEN_ENCRYPTION_KEY=your-token-encryption-key
